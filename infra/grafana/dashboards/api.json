{
  "title": "ÉcoleManager Pro — API", "uid": "em-api", "schemaVersion": 39, "refresh": "30s", "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requêtes / s par statut", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [ { "expr": "sum by (status) (rate(http_requests_total[5m]))" } ] },
    { "id": 2, "type": "timeseries", "title": "Latence p95 (objectif < 0,2 s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.2 } ] } } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" } ] },
    { "id": 3, "type": "table", "title": "Routes les plus lentes (p95)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [ { "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[15m]))))", "instant": true, "format": "table" } ] },
    { "id": 4, "type": "stat", "title": "Taux d'erreurs 5xx", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 }, "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [ { "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m])) / sum(rate(http_requests_total[5m]))" } ] },
    { "id": 5, "type": "timeseries", "title": "Mémoire (RSS)", "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 }, "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [ { "expr": "process_resident_memory_bytes" } ] }
  ]
}
