# Copy to .env. Never commit real values.
PG_USER=ecole
PG_PASSWORD=change-me
RABBIT_PASSWORD=change-me
MINIO_PASSWORD=change-me
KC_ADMIN_PASSWORD=change-me
# Adapters: sandbox (default, simulated) or live
PAYMENT_MODE=sandbox
PUSH_MODE=sandbox
SMS_MODE=sandbox
EMAIL_MODE=sandbox
MAPS_MODE=sandbox
AI_LLM_MODE=sandbox
STORAGE_MODE=sandbox
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY=   (live only)
# FCM_SERVICE_ACCOUNT_JSON=   (live push)
# TWILIO_SID= TWILIO_TOKEN= TWILIO_FROM=   (live SMS)
# SMTP_URL= EMAIL_FROM=   (live email)
MESSAGE_KEY=change-me-base64-32-bytes
ALLOW_STUDENT_PEER_MESSAGING=false
CORS_ORIGINS=http://localhost:3001
