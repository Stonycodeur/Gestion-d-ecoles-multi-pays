# Copy to .env. Never commit real values.
PG_USER=ecole
PG_PASSWORD=change-me
RABBIT_PASSWORD=change-me
MINIO_PASSWORD=change-me
KC_ADMIN_PASSWORD=change-me
# Adapters: sandbox (default, simulated) or live
PAYMENT_MODE=sandbox
PUSH_MODE=sandbox
SMS_MODE=sandbox
EMAIL_MODE=sandbox
MAPS_MODE=sandbox
AI_LLM_MODE=sandbox
STORAGE_MODE=sandbox
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY=   (live only)
# FCM_SERVICE_ACCOUNT_JSON=   (live push)
# TWILIO_SID= TWILIO_TOKEN= TWILIO_FROM=   (live SMS)
# SMTP_URL= EMAIL_FROM=   (live email)
MESSAGE_KEY=change-me-base64-32-bytes
ALLOW_STUDENT_PEER_MESSAGING=false
CORS_ORIGINS=http://localhost:3001

# --- Phase 5: paiement et GPS (aucun secret réel ici) ---
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=change-me-at-least-16-chars
PAYMENT_RETURN_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AIRTEL_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_SECRET=
MOOV_BASE_URL=
MOOV_API_KEY=
MOOV_CALLBACK_SECRET=
# base64 de 32 octets : openssl rand -base64 32
GPS_KEY=


# --- Phase 7: exploitation ---
APP_RUNTIME_PASSWORD=change-me
SANDBOX_JWT_SECRET=change-me-at-least-32-characters-long
WEBHOOK_KEY=change-me-base64-32-bytes
PUBLIC_API_URL=http://localhost:3000
# /metrics n'existe que si METRICS_TOKEN (>= 16 car.) est défini ; Prometheus lit le même jeton (METRICS_TOKEN_FILE)
METRICS_TOKEN=
# Sentry (facultatif) : l'API ne remonte que les erreurs 5xx, sans corps ni en-têtes
SENTRY_DSN=
