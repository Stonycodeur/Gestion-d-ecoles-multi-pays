{
  "name": "@ecolemanager/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "prebuild": "npm --prefix ../.. run build:packages",
    "pretest": "npm --prefix ../.. run build:packages",
    "seed:demo": "node dist/seed/demo-seed.js",
    "seed:keycloak": "node dist/seed/keycloak-users.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@ecolemanager/shared": "*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/websockets": "^12.6.0",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.1",
    "graphql": "^16.9.0",
    "amqplib": "^0.10.4",
    "ioredis": "^5.4.1",
    "jose": "^5.2.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs)/)"
    ]
  }
}
